generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  sessionVersion  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallet                  Wallet?
  beneficiaries           Beneficiary[]            @relation("BeneficiaryOwner")
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  fundingAttempts         FundingAttempt[]
}

model Wallet {
  id                         String   @id @default(cuid())
  accountNumber              String   @unique
  currency                   String   @default("NGN")
  balance                    Decimal  @default(0)
  personalDailyTransferLimit Decimal?
  transfersEnabled           Boolean  @default(true)
  userId                     String   @unique
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentTransactions     Transaction[]      @relation("SentTransactions")
  receivedTransactions Transaction[]      @relation("ReceivedTransactions")
  savedBy              Beneficiary[]      @relation("BeneficiaryWallet")
  ledgerEntries        LedgerEntry[]
  accountingAccount    AccountingAccount?
  fundingAttempts      FundingAttempt[]
}

model Transaction {
  id               String            @id @default(cuid())
  reference        String            @unique
  idempotencyKey   String?           @unique
  amount           Decimal
  narration        String?
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  senderWalletId   String?
  receiverWalletId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  senderWallet      Wallet?            @relation("SentTransactions", fields: [senderWalletId], references: [id])
  receiverWallet    Wallet?            @relation("ReceivedTransactions", fields: [receiverWalletId], references: [id])
  ledgerEntries     LedgerEntry[]
  accountingPosting AccountingPosting?

  @@index([senderWalletId])
  @@index([receiverWalletId])
  @@index([createdAt])
}

enum TransactionType {
  TRANSFER
  FUNDING
  PAYMENT
  REVERSAL
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  sessionVersion Int
  ipAddress      String?
  userAgent      String?
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LedgerEntry {
  id             String          @id @default(cuid())
  entryReference String          @unique
  walletId       String
  transactionId  String?
  direction      LedgerDirection
  source         LedgerSource
  amount         Decimal
  balanceBefore  Decimal
  balanceAfter   Decimal
  currency       String          @default("NGN")
  description    String?
  createdAt      DateTime        @default(now())

  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([transactionId])
  @@index([createdAt])
  @@index([walletId, createdAt])
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerSource {
  OPENING_BALANCE
  TRANSFER
  FUNDING
  PAYMENT
  REVERSAL
}

model AccountingAccount {
  id        String                @id @default(cuid())
  code      String                @unique
  name      String
  type      AccountingAccountType
  walletId  String?               @unique
  isSystem  Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  wallet Wallet?          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  lines  AccountingLine[]

  @@index([type])
}

model AccountingPosting {
  id            String    @id @default(cuid())
  reference     String    @unique
  transactionId String?   @unique
  description   String?
  postedAt      DateTime?
  createdAt     DateTime  @default(now())

  transaction Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  lines       AccountingLine[]

  @@index([postedAt])
  @@index([createdAt])
}

model AccountingLine {
  id        String         @id @default(cuid())
  postingId String
  accountId String
  side      AccountingSide
  amount    Decimal
  currency  String         @default("NGN")
  createdAt DateTime       @default(now())

  posting AccountingPosting @relation(fields: [postingId], references: [id], onDelete: Restrict)
  account AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([postingId])
  @@index([accountId])
  @@index([createdAt])
}

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountingSide {
  DEBIT
  CREDIT
}

model ReconciliationRun {
  id                        String               @id @default(cuid())
  status                    ReconciliationStatus @default(RUNNING)
  walletCount               Int                  @default(0)
  discrepancyCount          Int                  @default(0)
  ledgerErrorCount          Int                  @default(0)
  accountingErrorCount      Int                  @default(0)
  unfinishedPostingCount    Int                  @default(0)
  transactionCoverageErrors Int                  @default(0)
  report                    Json?
  startedAt                 DateTime             @default(now())
  completedAt               DateTime?

  @@index([status])
  @@index([startedAt])
}

enum ReconciliationStatus {
  RUNNING
  PASSED
  ISSUES_FOUND
  ERROR
}

model FundingAttempt {
  id                    String               @id @default(cuid())
  userId                String
  walletId              String
  idempotencyKey        String               @unique
  reference             String               @unique
  amount                Decimal
  currency              String               @default("NGN")
  provider              FundingProvider      @default(PAYSTACK)
  status                FundingAttemptStatus @default(PENDING)
  authorizationUrl      String?
  accessCode            String?
  providerTransactionId String?              @unique
  channel               String?
  paidAt                DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

enum FundingProvider {
  PAYSTACK
}

enum FundingAttemptStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  success    Boolean  @default(true)
  entityType String?
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Beneficiary {
  id        String   @id @default(cuid())
  ownerId   String
  walletId  String
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User   @relation("BeneficiaryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  wallet Wallet @relation("BeneficiaryWallet", fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([ownerId, walletId])
  @@index([ownerId])
  @@index([walletId])
}
